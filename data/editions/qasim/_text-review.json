{
  "226a": {
    "at": "2026-11-03T13:28:09.922Z",
    "text": "وَحَرِّكْ لِوَرْشٍ كُلَّ سَاكِنٍ اۨخِرٍ"
  },
  "435a": {
    "at": "2026-11-03T13:28:31.822Z",
    "text": "وَفِي ٱلۡمُتَعَالِۦ دُرُّهُ، وَٱلتَّلَاقِ وَٱلتۡـ"
  },
  "301a": {
    "at": "2026-11-03T13:28:46.321Z",
    "text": "وَفِي الكَهْفِ أَنسَىٰنِيـ وَمِنْ قَبْلُ جَاءَ مَنۡ"
  },
  "409b": {
    "at": "2026-11-03T13:30:37.804Z",
    "text": "وَرَبِّى ٱلَّذِى، ءَاتَىٰنِـــــــ ءَايَٰتِىَ الحُلَى"
  },
  "773b": {
    "at": "2026-11-03T13:31:11.175Z",
    "text": "وَتَأۡمَــۨــــــنَا لِلْكُلِّ يُخْفَى مُفَصَّلَا"
  },
  "897b": {
    "at": "2026-11-03T13:34:00.650Z",
    "text": "مَعاً مَنسِكًا فِي السِّينِ بِالكَسْرِ شُلْشُلَا"
  },
  "985a": {
    "at": "2026-11-03T13:34:42.737Z",
    "text": "وَفِي ٱلسَّيِّيِٕ المَخْفُوضِ هَمْزاً سُكُونُهُ"
  },
  "1047b": {
    "at": "2026-11-03T13:36:07.169Z",
    "text": "أَلِـتۡنَــٰــــــــ اكْسِرُوا دِنْيــــــاً، وَإِنَّ افْتَحُوا الجَلاَ"
  },
  "1068a": {
    "at": "2026-11-03T13:37:34.171Z",
    "text": "وَكَسْرُ جِــــــدَٰرٍ ضُمَّ وَالفَتْحُ وَاقْصُرُوا"
  },
  "1084a": {
    "at": "2026-11-03T13:38:01.233Z",
    "text": "دُعَـــــآءِى وَإِنِّى ثُمَّ بَيۡتِي مُضَافُهَــــا."
  },
  "1097b": {
    "at": "2026-11-03T13:38:27.266Z",
    "text": "تَشَآءُونَ حِصْناً. أُقِّتَتۡ وَاوُهُ حَلاَ"
  },
  "1111a": {
    "at": "2026-11-03T13:38:46.602Z",
    "text": "وَأَرْبَعُ غَيْبٍ بَعْدَ بَل لَّا حُصُولُهَا"
  },
  "h78": {
    "at": "2026-11-03T13:39:18.668Z",
    "text": "وَمِنْ سُورَةِ القِيَامَةِ إِلَى سُورَةِ النَّبَأِ"
  },
  "h79": {
    "at": "2026-11-03T13:39:29.468Z",
    "text": "وَمِنْ سُورَةِ النَّبَأ إِلَى سُورَةِ العَلَقِ"
  },
  "rule-ya": {
    "at": "2026-11-03T13:39:59.782Z"
  },
  "rule-la": {
    "at": "2026-11-03T13:40:36.322Z"
  }
}
