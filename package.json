{
  "name": "shatibiyyah-reader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node tests/verseText.test.ts",
    "build:app": "tsc --noEmit && vite build --mode app",
